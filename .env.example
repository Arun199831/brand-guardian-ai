

# --- Azure OpenAI (chat + embeddings) ---
AZURE_OPENAI_API_KEY=azure-openai-key
AZURE_OPENAI_ENDPOINT=https://your-openai-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# --- Azure AI Search (compliance rules knowledge base) ---
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_API_KEY=search-admin-key
AZURE_SEARCH_INDEX_NAME=compliance-rules

# --- Azure Video Indexer (ARM-based account) ---
AZURE_VI_NAME=video-indexer-name
AZURE_VI_LOCATION=eastus
AZURE_VI_ACCOUNT_ID=video-indexer-account-id
AZURE_SUBSCRIPTION_ID=subscription-id
AZURE_RESOURCE_GROUP=resource-group